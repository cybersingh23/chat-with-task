# LiteLLM proxy (same key/proxy as trajectory-viewer-v2)
LITELLM_API_KEY=your-litellm-api-key
LITELLM_BASE_URL=https://litellm-proxy.ml.scale.com/v1
LITELLM_MODEL=claude-opus-4-6

# Where sorted task buckets live (HARD_FAIL/SOFT_FAIL/PASS/UNSORTED)
WORKSPACE_ROOT=./workspace

# Colon-separated dirs scanned when a reviewer claims a task ID by hand
# (any ACC_DELIVERY_* folder underneath is searched for <task_id>/rank.json)
DELIVERY_ROOTS=~/Downloads

# Cost estimate shown on the admin Activity page ($ per 1M tokens). Tokens are
# exact (from the API); cost is computed at these rates. Defaults are Opus-tier.
PRICE_INPUT_PER_1M=15
PRICE_OUTPUT_PER_1M=75

# --- Redash pull (tools/get_tasks/pull_l10.py — admin "Pull L10" button) ---
# Required for the pull to work; everything else has sane defaults. Never commit it.
# Must be a Redash USER api key with access to the data source (not a query-scoped key).
REDASH_API_KEY=your-redash-api-key
# Redash data source backing the Snowflake queries (same as fill_rank.py).
REDASH_DATA_SOURCE_ID=30
# Published, parameterized Redash queries — running a SAVED query needs only view-only
# access, so a key without ad-hoc-query permission still works. Leave fill_rank's default
# unless it changes. Set L10_QUERY_ID once the L10-list query (params: project_id,
# review_level, status) is published — until then the "Pull L10" button falls back to
# ad-hoc SQL, which needs ad-hoc permission. "Pull these ids" works either way.
REDASH_QUERY_ID=324062
L10_QUERY_ID=0
# Which review layer the "Pull L10" button pulls, and which status counts as "unpaused".
L10_REVIEW_LEVEL=10
L10_STATUS=pending
# Optional cap for testing (0 = pull everything in the layer).
L10_PULL_LIMIT=0

PORT=4100
